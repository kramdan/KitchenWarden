{
  "name": "kitchenwarden",
  "version": "1.0.0",
  "description": "Application for the tracking of stats for pantry, fridge, and freezer goods and assisting in the tracking of recipes and weekly+ meal planning",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-test-module-mocks --import tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/assets/. dist/assets/ && cp -r src/views/aesthetics/. dist/views/aesthetics/",
    "start:build": "node ./dist/main.js",
    "start:dev": "tsx ./src/main.ts",
    "typecheck": "npx tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kramdan/KitchenWarden.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kramdan/KitchenWarden/issues"
  },
  "homepage": "https://github.com/kramdan/KitchenWarden#readme",
  "type": "module",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "postgres": "^4.1.1"
  }
}
